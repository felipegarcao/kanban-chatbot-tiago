# Copie para ".env" na VPS (ao lado do docker-compose.yml) e preencha com os valores reais.
# Esse arquivo é só o modelo: o "docker compose" lê automaticamente um ".env" no mesmo
# diretório pra substituir as variáveis ${...} do docker-compose.yml.

# Host = nome do container do Postgres na MESMA rede docker (não IP — o IP muda a cada
# restart do container; o nome resolve sozinho via DNS interno do Docker). Confirme o nome
# real com `docker ps` / `docker inspect evolution_postgres` se "evolution_postgres" não bater.
DATABASE_URL=postgres://evolution:SENHA_REAL_AQUI@evolution_postgres:5432/evolution

# Gere um novo, NÃO reaproveite o de desenvolvimento: openssl rand -base64 48
SESSION_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

N8N_WEBHOOK_FINALIZAR_ATENDIMENTO_URL=https://n8n.felipesystem.com.br/webhook/pos-pagamento/iniciar
